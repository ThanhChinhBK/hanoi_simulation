{
  "name": "hanoi-whatif-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "prepare-data": "node scripts/prepare-data.mjs",
    "build:wasm": "cd ../engine-wasm && wasm-pack build --target web --release --out-dir pkg",
    "predev": "npm run prepare-data",
    "dev": "vite",
    "prebuild": "npm run prepare-data",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "e2e": "playwright test"
  },
  "dependencies": {
    "@deck.gl/core": "^9.4.0",
    "@deck.gl/geo-layers": "^9.4.0",
    "@deck.gl/layers": "^9.4.0",
    "@deck.gl/mapbox": "^9.4.0",
    "maplibre-gl": "^6.13.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.3"
  }
}
